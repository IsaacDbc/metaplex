# Hunter.io API key (free tier: 25 searches/month)
# Sign up at https://hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# Bing Search API key (optional, for better search results)
# Sign up at https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=your_bing_api_key_here

# LinkedIn session cookie (optional, for LinkedIn scraping)
# Get it from your browser after logging in: Cookie > li_at
LINKEDIN_LI_AT=your_li_at_cookie_here

# Proxies (optional, to avoid rate limiting)
# Format: http://user:pass@host:port
PROXY_LIST=

# Request delay in seconds (be respectful to servers)
REQUEST_DELAY=2
