# Configuration des alertes email Techunt
# Copie ce fichier en .env et remplis les valeurs

# Expéditeur (ton compte Gmail)
ALERT_EMAIL_FROM=ton.email@gmail.com

# App Password Gmail (PAS ton mot de passe normal)
# Génère-le ici : https://myaccount.google.com/apppasswords
# Format : "xxxx xxxx xxxx xxxx" (16 caractères avec espaces)
ALERT_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Destinataire (toi ou toute ton équipe)
ALERT_EMAIL_TO=isaac@techunt.fr

# SMTP custom (optionnel - défaut Gmail)
# ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
# ALERT_EMAIL_SMTP_PORT=587
